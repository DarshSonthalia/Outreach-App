
# ===========================================
# Email Outreach Platform - Environment Config
# ===========================================
# Copy this file to .env and fill in values

# ----- Database -----
# Required for docker-compose and app connection
POSTGRES_USER=outreach
POSTGRES_PASSWORD=your-secure-pass
POSTGRES_DB=outreach_db
# In Docker: use service name 'db'. Local: use 'localhost'
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----- Redis -----
# In Docker: use service name 'redis'. Local: use 'localhost'
REDIS_URL=redis://redis:6379/0

# ----- Security -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Encryption key for OAuth tokens at rest
# MUST be a valid Fernet key (32 url-safe base64 characters)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=change-this-to-valid-fernet-key-base64=

# ----- Google OAuth -----
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Production: https://your-domain.com/api/mailboxes/oauth/callback
# Development: http://localhost:8000/api/mailboxes/oauth/callback
GOOGLE_REDIRECT_URI=https://your-domain.com/api/mailboxes/oauth/callback

# ----- URLs -----
# Critical for CORS, Redirects, and API clients
# Production Example:
# FRONTEND_URL=https://your-domain.com/app
# BACKEND_URL=https://your-domain.com
# APP_PUBLIC_BASE_URL=https://your-domain.com

# Development Example:
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:8000
# APP_PUBLIC_BASE_URL=http://localhost:3000

FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com
APP_PUBLIC_BASE_URL=https://your-domain.com

# ----- Frontend Build/Runtime -----
# Used by Next.js client-side code
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api

# ----- Calendly (Required for booking webhooks) -----
# Get this from Calendly when creating the webhook subscription
CALENDLY_WEBHOOK_SECRET=your-calendly-webhook-signing-key

# ----- OpenAI / AI Integration -----
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL_REPLY_DRAFT=gpt-4o
OPENAI_MODEL_REPLY_CLASSIFY=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# ----- Google Custom Search (Lead Gen) -----
# Optional - for lead sourcing features
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_GL=us
GOOGLE_CSE_HL=en
