# ===========================================
# Email Outreach Platform - Environment Config
# ===========================================
# Copy this file to .env and fill in values

# ----- Database -----
POSTGRES_USER=outreach
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=outreach_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Security -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Fix B1: Encryption key for OAuth tokens at rest
# MUST be a valid Fernet key (32 url-safe base64 characters)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=your-fernet-encryption-key-here

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mailboxes/oauth/callback

# ----- Frontend -----
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
APP_PUBLIC_BASE_URL=http://localhost:8000

# ----- Calendly (Required for booking webhooks) -----
# Fix C1: Webhook signature verification secret
# Get this from Calendly when creating the webhook subscription
CALENDLY_WEBHOOK_SECRET=your-calendly-webhook-signing-key-here

# ----- Safety Defaults (DO NOT MODIFY - hardcoded in app/config.py) -----
# These values are enforced by the application and cannot be overridden
# SAFETY_DAY1_LIMIT=10
# SAFETY_DAY2_LIMIT=15
# SAFETY_DAY3_LIMIT=20
# SAFETY_DAY4_PLUS_LIMIT=25
# SAFETY_HARD_CAP=30
# BOUNCE_THROTTLE_THRESHOLD=2
# BOUNCE_PAUSE_THRESHOLD=4

# ----- OpenAI / LLM Integration -----
# OpenAI API Key (required for AI features)
# Get from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Model selection (defaults shown; supports gpt-4o-mini, gpt-4, etc.)
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_LINT=gpt-4o-mini
OPENAI_MODEL_CLASSIFY=gpt-4o-mini

# Timeout and retry settings
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
